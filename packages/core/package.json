{
  "name": "@ng-census/core",
  "version": "0.1.0",
  "description": "The analyzer engine behind ng-census: measures legacy and modern Angular patterns and returns data with file, line and column.",
  "keywords": [
    "ai-generated-code",
    "analyzer",
    "angular",
    "angular-cli",
    "ci",
    "code-quality",
    "control-flow",
    "inject",
    "legacy-code",
    "library",
    "lint",
    "metrics",
    "migration",
    "signals",
    "standalone",
    "static-analysis"
  ],
  "homepage": "https://github.com/MeAkib/ng-census#readme",
  "bugs": {
    "url": "https://github.com/MeAkib/ng-census/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MeAkib/ng-census.git",
    "directory": "packages/core"
  },
  "license": "MIT",
  "author": "Akib (https://github.com/MeAkib)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "prepack": "node ../../scripts/prepare-package.mjs",
    "prepublishOnly": "cd ../.. && npm test"
  },
  "dependencies": {
    "@angular/compiler": "^22.1.6",
    "ts-morph": "^28.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
